{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbital-server",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // The web game is served from the same Worker, so invite links open in any browser.
  "assets": { "directory": "../web", "not_found_handling": "none" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "HUB", "class_name": "Hub" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Hub"] }],
  "observability": { "enabled": true }
}
